exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > read_network_request contract 1`] = `
{
  "description": "Read one captured request's latest redirect hop by tabId and requestId. request.status is the CDP response status; responseHeaders.statusCode when source=extra-info is the network status (cached revalidation may show 200 vs 304). Extra-info may be pending or unavailable. (capture starts with read_network_requests). sessionId defaults to the main session; pass a child entry's source.sessionId for its details. Returns bounded headers with known authentication fields redacted; not a byte-for-byte wire capture. includeHeaders=false omits both header maps. includeBody defaults to true and reads a finished text/JSON response up to maxChars; responseBodyFormat=binary returns byteLength, sha256 and prefixBytes hex (0..256, default 0), max 1 MiB. includeRequestBody=true reads the request body; requestBodyFormat is text (default; text/JSON/form-urlencoded), base64 (non-text bytes, not redacted, completeness unknown) or multipart (fields with known credentials redacted, file content omitted, always partial). Total output is limited to 50000 characters. Bodies are read on demand, never cached, and may be evicted by Chrome. includeHeaders=false does not disable body reading. Use includeBody=false for metadata of failed, pending or redirected requests, or unavailable bodies. Unreadable bodies return with body/requestBody.state=unavailable and reason=not_finished, expired or too_large; metadata and independently readable bodies remain available. Check each body state before using it. Invalid formats, malformed data, unknown CDP failures and stale observations still fail the whole call. Text/request raw CDP strings are limited to 1048576 UTF-16 code units before decoding/truncation; lowering maxChars does not bypass this limit. Use includeRequestBody=false to omit request-body reading. requestBody.state=absent requires an explicit native hasPostData=false; a missing signal is not proof of no body. With missing presence/MIME metadata, text mode probes Chrome; no post data returns unavailable/expired and may mean no body or data no longer retained. Request URLs and header URLs (including relative Location) mask known authentication query values, including _vercel_jwt/_vercel_jwe, before caching/truncation. Redaction covers known credentials only; other sensitive body data may remain.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "includeBody": {
        "default": true,
        "type": "boolean",
      },
      "includeHeaders": {
        "default": true,
        "type": "boolean",
      },
      "includeRequestBody": {
        "default": false,
        "type": "boolean",
      },
      "maxChars": {
        "default": 20000,
        "maximum": 50000,
        "minimum": 1,
        "type": "integer",
      },
      "prefixBytes": {
        "maximum": 256,
        "minimum": 0,
        "type": "integer",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
      "requestBodyFormat": {
        "enum": [
          "text",
          "base64",
          "multipart",
        ],
        "type": "string",
      },
      "requestId": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string",
      },
      "responseBodyFormat": {
        "enum": [
          "text",
          "binary",
        ],
        "type": "string",
      },
      "sessionId": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string",
      },
      "tabId": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
    },
    "required": [
      "tabId",
      "requestId",
    ],
    "type": "object",
  },
  "name": "read_network_request",
}
`;

