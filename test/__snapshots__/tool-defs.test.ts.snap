{
  "description": "Manage opt-in local observation history: status, configure, read, clear. Recording defaults off and only covers observations already enabled in MIE. configure requires enabled; disabling keeps saved records. read accepts optional tabId, captureId, kind, beforeId and limit (default 100), newest first with nextCursor; expired cursors fail. clear removes this history only. History survives extension restart. No headers or bodies are saved; known credentials and URL query/userinfo/fragment are removed, other sensitive text may remain.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "action": {
