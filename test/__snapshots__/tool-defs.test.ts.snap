exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > request contract 1`] = `
{
  "description": "Bounded same-origin HTTP request in the managed tab's login session. expectedOrigin is required and checked against the live document. GET/HEAD read; POST/PUT/PATCH/DELETE require allowWrite=true. No custom headers; body requires contentType. Never follows redirects (code=REDIRECT_NOT_FOLLOWED, status/location null when the browser hides them) and never retries. Returns status, allowlisted headers and bounded text with known credentials redacted; other secrets may remain. responseBodyFormat=binary returns bytesRead, sha256 (null when truncated) and an unredacted prefixHex (prefixBytes default 0, max 256) instead of text; maxBytes caps at 50000. responseBodyFormat=hashOnly hashes to EOF without returning the body (maxBytes default 20000, max 67108864) and returns bytesRead/complete/sha256/termination (eof|byte-limit|timeout|read-error); sha256 is null unless complete. timeoutMs max 15000. A 206 digest covers only that range.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "allowWrite": {
        "default": false,
        "type": "boolean",
      },
      "body": {
        "maxLength": 65536,
        "type": "string",
      },
      "contentType": {
