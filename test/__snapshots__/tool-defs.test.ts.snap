exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > form_input contract 1`] = `
{
  "description": "Set an input, textarea, select or contenteditable value by node ref. clear=true empties it (same as value=""). Uses native input/textarea setters and input/change events for controlled forms. Credential and verification fields are rejected. Recognized public token counts, token names and saved API key IDs are supported in matching native controls. Results return checked/matched status without page values or page exception text. With frameId, backendNodeId must be an issued read_page/find ref from that frame, not a native CDP node id.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "backendNodeId": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
