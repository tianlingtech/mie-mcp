        "enum": [
          "console",
          "network",
        ],
        "type": "string",
      },
      "limit": {
        "maximum": 200,
        "minimum": 1,
        "type": "integer",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
