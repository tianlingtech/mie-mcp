exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > javascript_exec contract 1`] = `
{
  "description": "Execute code as an async function body in the managed tab main document's MAIN world. Use return to produce JSON data. Requires allowUnsafe=true and the live expectedOrigin (HTTP/S). Can mutate pages, install hooks and access session data; output is NOT redacted. No automatic retry or rollback. timeoutMs defaults to 5000ms (1..15000); it bounds waiting, not background side effects. SCRIPT_TIMEOUT includes effectiveTimeoutMs and elapsedMs for the failed run, including CDP attachment/waiting. untilTruthyMs (max 300000) re-runs code every 500ms until it returns a truthy value and adds matched/timedOut/elapsedMs; timeoutMs then bounds each run. maxChars rejects oversized JSON output. OUTPUT_TOO_LARGE includes effectiveMaxChars and actualSerializedChars in UTF-16 code units (including JSON syntax), without an output excerpt. Return selected fields or smaller pages; the script has already run and side effects are not rolled back. SCRIPT_FAILED includes bounded name/message/stack JSON with truncated/extractionFailed flags (not redacted). Restore installed hooks yourself.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "allowUnsafe": {
        "const": true,
        "type": "boolean",
      },
      "code": {
        "maxLength": 65536,
        "minLength": 1,
        "type": "string",
      },
      "expectedOrigin": {
        "format": "uri",
        "type": "string",
      },
      "maxChars": {
        "default": 20000,
        "maximum": 50000,
        "minimum": 1,
        "type": "integer",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
      "tabId": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "timeoutMs": {
        "default": 5000,
        "maximum": 15000,
        "minimum": 1,
        "type": "integer",
      },
      "untilTruthyMs": {
        "maximum": 300000,
        "minimum": 1,
        "type": "integer",
      },
    },
    "required": [
      "tabId",
      "expectedOrigin",
      "allowUnsafe",
      "code",
    ],
    "type": "object",
  },
  "name": "javascript_exec",
}
`;

