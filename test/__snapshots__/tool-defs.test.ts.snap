        "default": "GET",
        "enum": [
          "GET",
          "HEAD",
          "POST",
          "PUT",
          "PATCH",
          "DELETE",
        ],
        "type": "string",
      },
      "prefixBytes": {
        "maximum": 256,
        "minimum": 0,
        "type": "integer",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
      "responseBodyFormat": {
