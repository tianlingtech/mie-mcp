exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > tabs_context contract 1`] = `
{
  "description": "List managed tabs: id, URL, title, active, ownerSessionId and ownerKind (mcp, relay or null). relayOwnerId is the live relay connection id; relay tabs with another id were left by an ended connection. extensionVersion is the extension loaded in this profile; use it to confirm a reload. mineOnly filters to this MCP process. includeClosed=true adds closedTabs (latest 100, 24h): result is the MIE close attempt, closedAt the actual Chrome event; external closes have null result/closer; no URLs. With includeClosed=true and mineOnly=false, lifecycleDiagnostics adds the latest 50 local metadata events, storage status and retention (200 records, 7 days). No URLs/titles/content; failed native tab-strip close clicks are not observable.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "includeClosed": {
        "type": "boolean",
      },
      "mineOnly": {
        "type": "boolean",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
    },
    "type": "object",
  },
  "name": "tabs_context",
}
`;

