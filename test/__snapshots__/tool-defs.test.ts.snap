exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > tabs_create contract 1`] = `
{
  "description": "Create a background tab and return tabId/ownerSessionId. Without capture flags, it does not wait for navigation or load. With captureNetwork/captureConsole and a URL, it enables capture BEFORE navigation and waits for load. Load does not imply application readiness; wait_for the expected element or state before interacting. MCP injects owner session.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "captureConsole": {
        "type": "boolean",
      },
      "captureNetwork": {
        "type": "boolean",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
      "url": {
        "format": "uri",
        "type": "string",
      },
    },
    "type": "object",
  },
  "name": "tabs_create",
}
`;

exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > wait_for 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "backendNodeId": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer",
    },
    "exact": {
      "type": "boolean",
    },
    "excludeResourceTypes": {
      "items": {
        "enum": [
          "Document",
          "Stylesheet",
          "Image",
          "Media",
          "Font",
          "Script",
          "TextTrack",
          "XHR",
          "Fetch",
          "Prefetch",
          "EventSource",
          "WebSocket",
          "Manifest",
          "SignedExchange",
          "Ping",
          "CSPViolationReport",
          "Preflight",
          "Other",
        ],
        "type": "string",
      },
      "maxItems": 20,
      "type": "array",
    },
    "excludeUrlPatterns": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string",
      },
      "maxItems": 20,
      "type": "array",
    },
    "expected": {
      "maxLength": 4000,
      "type": "string",
    },
    "frameId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
    },
    "idleMs": {
      "maximum": 5000,
      "minimum": 100,
      "type": "integer",
    },
    "match": {
      "enum": [
        "equals",
        "contains",
      ],
      "type": "string",
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string",
    },
    "profile": {
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string",
    },
    "query": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string",
    },
    "role": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string",
    },
    "selector": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string",
    },
    "state": {
      "enum": [
        "attached",
        "detached",
        "visible",
        "hidden",
        "enabled",
        "disabled",
        "text",
        "value",
        "url",
        "network_idle",
      ],
      "type": "string",
    },
    "tabId": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer",
    },
    "timeoutMs": {
      "maximum": 300000,
      "minimum": 0,
      "type": "integer",
    },
  },
  "required": [
    "tabId",
    "state",
    "timeoutMs",
  ],
  "type": "object",
}
`;

exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > wait_for contract 1`] = `
{
  "description": "Wait for attached/detached/visible/hidden/enabled/disabled/text/value/url/network_idle. Element target: backendNodeId, CSS selector, or query/role/name/exact (first match, re-queried). url and network_idle take no target or frameId. text/value/url require expected; match defaults to equals (or contains). timeoutMs is required, 0..300000; polling slows after 20s. Returns matched/timedOut/elapsedMs/actual. text compares textContent (CSS text-transform not applied); for text/value, actual omits layout and a match keeps only the text near it. hidden means absent or without visible layout, not offscreen. network_idle counts only requests observed since capture began (use captureNetwork before navigation); idleMs defaults to 500. excludeResourceTypes (CDP types) and excludeUrlPatterns (case-sensitive URL substrings, not glob/regex) skip matching requests, at most 20 each. On timeout actual lists pendingRequests (oldest 10) and pendingRequestsOmitted. Sensitive content comparisons are rejected. Does not imply navigation success.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "backendNodeId": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "exact": {
        "type": "boolean",
      },
      "excludeResourceTypes": {
        "items": {
          "enum": [
            "Document",
            "Stylesheet",
            "Image",
            "Media",
            "Font",
            "Script",
            "TextTrack",
            "XHR",
            "Fetch",
            "Prefetch",
            "EventSource",
            "WebSocket",
            "Manifest",
            "SignedExchange",
            "Ping",
            "CSPViolationReport",
            "Preflight",
            "Other",
          ],
          "type": "string",
        },
        "maxItems": 20,
        "type": "array",
      },
      "excludeUrlPatterns": {
        "items": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 20,
        "type": "array",
      },
      "expected": {
        "maxLength": 4000,
        "type": "string",
      },
      "frameId": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string",
      },
      "idleMs": {
        "maximum": 5000,
        "minimum": 100,
        "type": "integer",
      },
      "match": {
        "enum": [
          "equals",
          "contains",
        ],
        "type": "string",
      },
      "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
      "query": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
      "role": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string",
      },
      "selector": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string",
      },
      "state": {
        "enum": [
          "attached",
          "detached",
          "visible",
          "hidden",
          "enabled",
          "disabled",
          "text",
          "value",
          "url",
          "network_idle",
        ],
        "type": "string",
      },
      "tabId": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "timeoutMs": {
        "maximum": 300000,
        "minimum": 0,
        "type": "integer",
      },
    },
    "required": [
      "tabId",
      "state",
      "timeoutMs",
    ],
    "type": "object",
  },
  "name": "wait_for",
}
`;
