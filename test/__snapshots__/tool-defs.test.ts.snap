exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > graphics_diagnostics contract 1`] = `
{
  "description": "Read bounded canvas layout metadata in a managed tab's selected frame, including opaque/OOPIF frames and open shadow roots. No AX node ref is needed. Returns buffer dimensions, CSS rectangles, CSS visibility and intersection with that frame's viewport. Does not check occlusion or ancestor-frame visibility. Never calls getContext, reads pixels, mutates DOM or refreshes the page; WebGL context-loss state is unknown without an existing context reference. Fixed numeric/boolean/enumerated output only: no URLs, text, attributes, form values, credentials or arbitrary objects. Layout reads can force layout. Scans at most 2000 elements; maxCanvases defaults to 10 (1..20). truncated means a scan/output limit was reached.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "frameId": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string",
      },
      "maxCanvases": {
        "default": 10,
        "maximum": 20,
        "minimum": 1,
        "type": "integer",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
      "tabId": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
    },
    "required": [
      "tabId",
    ],
    "type": "object",
  },
  "name": "graphics_diagnostics",
}
`;

