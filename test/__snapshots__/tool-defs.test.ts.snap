exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > computer contract 1`] = `
{
  "description": "Capture pixels or send mouse, keyboard, scroll and wait actions. Coordinates are viewport CSS pixels, not scaled image pixels; re-capture after scroll or layout changes. action=screenshot: PNG or format=jpeg (quality=1..100), scale=0.1..1, optional viewport-relative clip. savePath saves under MIE_SCREENSHOT_DIR (default cwd/.e2e-test/screenshots) as .png/.jpg/.jpeg; overwrite=true replaces an existing file. The result includes screenshotViewport and coordinateMapping: viewportX=origin.x+imageX*cssPixelsPerImagePixel.x (same for Y). action=click: exactly one of coordinate [x, y] or backendNodeId (a [ref_N] from read_page/find); clickCount=1..3; check the returned hit. Hit attributes omit value, summarize data URLs as MIME/length without payload, and cap values at 512 UTF-16 code units, names at 128, count at 32 and serialized attributes JSON at 4096. attributesTruncated marks summaries/truncation; attributesOmitted counts budget-omitted pairs. Other attribute data is not generally redacted. action=drag: coordinate to toCoordinate. action=type: inserts text at the current selection; backendNodeId focuses an editable target first, otherwise the focused editable element is used (waits up to 250ms, errors if none) and the result names it in target. Use form_input to replace or clear. Canvas-drawn inputs without a DOM editable are not type targets: click to focus, then try individual key actions and verify the result. action=key: key plus optional modifiers and holdMs (0-1000, default 0). Each call presses and releases the key on the same tab. Holding does not generate repeated keydown events. action=scroll: direction + distance (px) at coordinate (default viewport center); nested scroll containers need their own coordinate. action=wait: milliseconds (max 10000). frameId applies to backendNodeId click/type only and needs a ref issued for that frame.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "screenshot",
          "click",
          "drag",
          "type",
          "key",
          "scroll",
          "wait",
        ],
        "type": "string",
      },
      "backendNodeId": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "clickCount": {
        "maximum": 3,
        "minimum": 1,
        "type": "integer",
      },
      "clip": {
        "additionalProperties": false,
        "properties": {
          "height": {
            "exclusiveMinimum": 0,
            "type": "number",
          },
          "width": {
            "exclusiveMinimum": 0,
            "type": "number",
          },
          "x": {
            "minimum": 0,
            "type": "number",
          },
          "y": {
            "minimum": 0,
            "type": "number",
          },
        },
        "required": [
          "x",
          "y",
          "width",
          "height",
        ],
        "type": "object",
      },
      "coordinate": {
        "items": {
          "minimum": 0,
          "type": "number",
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array",
      },
      "direction": {
        "enum": [
          "up",
          "down",
          "left",
          "right",
        ],
        "type": "string",
      },
      "distance": {
        "exclusiveMinimum": 0,
        "type": "number",
      },
      "format": {
        "enum": [
          "png",
          "jpeg",
        ],
        "type": "string",
      },
      "frameId": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string",
      },
      "holdMs": {
        "maximum": 1000,
        "minimum": 0,
        "type": "integer",
      },
      "key": {
        "minLength": 1,
        "type": "string",
      },
      "milliseconds": {
        "maximum": 10000,
        "minimum": 0,
        "type": "integer",
      },
      "modifiers": {
        "items": {
          "enum": [
            "Alt",
            "Control",
            "Meta",
            "Shift",
          ],
          "type": "string",
        },
        "maxItems": 4,
        "type": "array",
      },
      "overwrite": {
        "type": "boolean",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
      "quality": {
        "maximum": 100,
        "minimum": 1,
        "type": "integer",
      },
      "savePath": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string",
      },
      "scale": {
        "maximum": 1,
        "minimum": 0.1,
        "type": "number",
      },
      "tabId": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "text": {
        "maxLength": 65536,
        "type": "string",
      },
      "toCoordinate": {
        "items": {
          "minimum": 0,
          "type": "number",
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array",
      },
    },
    "required": [
      "tabId",
      "action",
    ],
    "type": "object",
  },
  "name": "computer",
}
`;

