exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > set_password_from_file contract 1`] = `
{
  "description": "Set a top-level input[type=password] from an explicitly granted local file. Never supply the password as a tool argument. Configure grants locally in ~/.config/mie/password-grants.json (version=1, grants array); no MCP tool creates grants. Each grant binds exact filePath, expectedOrigin, expectedPathname and profile; an omitted grant profile permits only default. Both grant and password files must be current-user 0600 regular files at canonical absolute paths. Parent directories must be owned by the current user or root; group/other writable parents require the sticky bit. The password file is at most 4096 UTF-8 bytes, without trimming. Rejects symlinks, empty files and NUL. Checks the live document, origin, pathname and password input atomically. Returns only ok and backendNodeId, with fixed safe errors. Does not submit or retry. Input/change handlers still run; page scripts and later observations are outside the no-echo guarantee. No iframe support.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "backendNodeId": {
        "exclusiveMinimum": 0,
