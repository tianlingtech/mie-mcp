exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > screenshot_diagnostics contract 1`] = `
{
  "description": "Read local screenshot diagnostic metadata, newest first, or clear this profile's records. action defaults to read; diagnosticId/tabId filters and limit (default 20, max 150) apply to read. Takes no screenshot and does not attach or activate tabs; closed tabs can be queried. Records are kept 7 days, capped at 50 successes, 50 failures and 50 unfinished calls. Caller and CDP outcomes are recorded separately; a timeout does not cancel Chrome. No pixels, URLs, titles or page content. Check storage status; unwritten history is not guaranteed.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "action": {
        "default": "read",
        "enum": [
          "read",
          "clear",
        ],
        "type": "string",
      },
      "diagnosticId": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string",
      },
