exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > find contract 1`] = `
{
  "description": "Find up to 20 elements in the accessibility tree; all provided filters must match. query: case-insensitive substring match on role, name or value. role: whole role, case-insensitive. name: whitespace-collapsed, case-insensitive substring, or exact=true for case-sensitive whole name (a blank name requires exact=true). selector: main-frame CSS selector such as [data-testid="x"]. Provide at least one of them. Returns refs in document order. within limits to descendants of a ref. near ranks by tree distance to matching text. nth picks a zero-based match before the cap. includeBox=true (main frame) appends box=[x,y,width,height] in viewport CSS pixels to tell same-named elements apart. timeoutMs=0..20000 retries while nothing matches and returns matched/timedOut/elapsedMs. frameId searches a frame and returns refs valid only with that frameId. AX-disabled matches append disabled=true; absence does not guarantee actionability. This is a snapshot, not a wait for enabled state. Not natural language understanding.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "exact": {
        "default": false,
        "type": "boolean",
      },
      "frameId": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string",
      },
      "includeBox": {
        "type": "boolean",
      },
      "name": {
        "maxLength": 200,
        "type": "string",
      },
      "near": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
      "nth": {
        "maximum": 100000,
        "minimum": 0,
        "type": "integer",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
      "query": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
      "role": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string",
      },
      "selector": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string",
      },
      "tabId": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "timeoutMs": {
        "maximum": 20000,
        "minimum": 0,
        "type": "integer",
      },
      "within": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
