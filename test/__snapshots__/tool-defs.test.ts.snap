exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > cookies_list contract 1`] = `
{
  "description": "Read-only cookie listing for this profile. url lists cookies Chrome would send to that http(s) URL (parent-domain cookies included); domain lists cookies whose domain equals or is a subdomain of it. Optional exact name filter. Returns name, domain, hostOnly, path, expires (ISO, null for session), httpOnly, secure, sameSite, valueLength and valueSha256 (first 12 hex). Values are never returned; compare a known candidate by its sha256 prefix. At most 200 cookies.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "domain": {
        "maxLength": 253,
        "minLength": 1,
        "pattern": "^\\.?[a-z0-9.-]+$",
        "type": "string",
      },
      "name": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
      "url": {
        "format": "uri",
        "type": "string",
      },
    },
    "type": "object",
  },
  "name": "cookies_list",
}
`;

