exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > read_console_messages contract 1`] = `
{
  "description": "Read console calls and uncaught errors for the tab. The first call starts capture, so call it before triggering the action. pattern is a case-insensitive substring on level or text; patternMode=regex uses RE2 (inline flags allowed, no lookaround/backreferences, at most 128 compiled instructions). excludeExtensions=true hides chrome-extension:// sources. includeSubSessions=true adds iframe and worker sessions; their entries carry source, and subSessions reports readiness. Returns the latest limit entries (1..200, default 100), oldest first; the capture buffer keeps up to 500 across navigation until detach, close or restart. clear empties all entries after reading, not opt-in history (use observation_history).",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "clear": {
        "default": false,
        "type": "boolean",
      },
