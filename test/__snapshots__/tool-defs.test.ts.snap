exports[`shared tool definitions > matches the derived JSON Schema contract snapshots > read_network_requests contract 1`] = `
{
  "description": "Known authentication query values, including _vercel_jwt/_vercel_jwe, are masked before URL caching/truncation; ordinary query values remain. Read request summaries for the tab. The first call starts capture, so call it before triggering the action; an empty result only covers captured traffic. urlPattern is a case-sensitive URL substring; patternMode=regex uses RE2 (inline flags allowed, no lookaround/backreferences, at most 128 compiled instructions). states selects any of pending/redirected/finished/failed. excludeExtensions/excludeDataUrls hide chrome-extension:// and data: URLs. Filters combine with AND before limit. includeSubSessions=true adds iframe and worker sessions; their entries carry source, and subSessions reports readiness. Returns the latest limit entries (1..200, default 100), oldest first; the capture buffer keeps up to 500 across navigation until detach, close or restart. status is the CDP response status; a revalidated cached response may show 200 while read_network_request responseHeaders.statusCode from extra-info shows 304. Extra-info may be pending or unavailable. receivedAt is when the request started (epoch ms); durationMs runs from it to finish or failure. clear empties all entries after reading, not opt-in history (use observation_history). Use read_network_request for headers and bodies.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "clear": {
        "default": false,
        "type": "boolean",
      },
      "excludeDataUrls": {
        "type": "boolean",
      },
      "excludeExtensions": {
        "type": "boolean",
      },
      "includeSubSessions": {
        "default": false,
        "type": "boolean",
      },
      "limit": {
        "default": 100,
        "maximum": 200,
        "minimum": 1,
        "type": "integer",
      },
      "patternMode": {
        "enum": [
          "substring",
          "regex",
        ],
        "type": "string",
      },
      "profile": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string",
      },
      "states": {
        "items": {
          "enum": [
            "pending",
            "redirected",
            "finished",
            "failed",
          ],
          "type": "string",
        },
        "maxItems": 4,
        "minItems": 1,
        "type": "array",
      },
      "tabId": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "urlPattern": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "tabId",
    ],
    "type": "object",
  },
  "name": "read_network_requests",
}
`;

